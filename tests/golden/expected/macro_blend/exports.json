 "Configuration (YAML)": {
  "label": "Configuration (YAML)",
  "file_name": "config_macro_gate.yaml",
  "mime": "text/yaml",
  "digest": "e101c513ba007ec6",
  "text": [
   "label: Macro Gate",
   "data:",
   "  source: upload",
   "  tickers:",
   "  - XEI.TO",
   "  - XIC.TO",
   "  - ZEB.TO",
   "  - ZLB.TO",
   "  start: '1990-01-01'",
   "  end: null",
   "  benchmark: null",
   "  cash_proxy: null",
   "  price_field: Close",
   "  fill_limit: 5",
   "  min_history: 60",
   "  adjusted: false",
   "  use_dividends: true",
   "  base_currency: ''",
   "  currencies: {}",
   "exog:",
   "  enabled: true",
   "  publication_lag_days: 30",
   "  ffill_limit: null",
   "  columns:",
   "  - ISM_MANUFACTURING",
   "  - BBB_CREDIT_SPREAD",
   "  - POLICY_RATE",
   "  note: economic_data.csv",
   "strategy:",
   "  mode: builtin",
   "  name: macro_gate",
   "  params:",
   "    series: ISM_MANUFACTURING",
   "    rule: Above its moving average",
   "    window: 250",
   "    threshold: 0.0",
   "    risk_off: 0.0",
   "    sizing: Equal Weight",
   "    vol_window: 60",
   "  weights_normalize: None",
   "  weights_calendar: File dates",
   "  weights_source: ''",
   "engine:",
   "  initial_capital: 100000.0",
   "  rebalance: Q",
   "  execution_lag: 1",
   "  max_leverage: 1.0",
   "  min_trade_weight: 0.005",
   "  periods_per_year: 252",
   "  execute_at_open: false",
   "  trim_warmup: true",
   "  whole_shares: false",
   "  day_rule: last",
   "  day_of_month: 15",
   "  weekday: 4",
   "  nth: 1",
   "  anchor_month: 12",
   "  cash_sweep: none",
   "  cash_sweep_threshold: 0.0",
   "  cash_buffer: 0.01",
   "  fx_cash: net",
   "costs:",
   "  commission_bps: 5.0",
   "  slippage_bps: 25.0",
   "  impact_model: flat",
   "  impact_bps_at_10pct_adv: 25.0",
   "  impact_coef: 1.0",
   "  slippage_overrides: {}",
   "  apply_frictions_to_fee_liquidation: true",
   "  cash_rate_pa: 0.0",
   "  borrow_rate_pa: 0.0",
   "  management_fee_pa: 0.0",
   "  fx_spread_bps: 25.0",
   "  foreign_cash_rate_pa: 0.0"
  ]
 },
